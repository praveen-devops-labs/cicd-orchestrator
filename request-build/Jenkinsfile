@Library('cicd-library') _

import java.util.UUID

pipeline {

    agent any

    triggers {

        GenericTrigger(

            token: 'request-trigger',

            genericVariables: [

                [
                    key: 'POST_CONTENT',
                    value: '$'
                ]
            ],

            printContributedVariables: true,
            printPostContent: true
        )
    }

    options {

        disableConcurrentBuilds()

        buildDiscarder(
            logRotator(numToKeepStr: '20')
        )

        timestamps()
    }

    stages {

        stage('Process Deployment Request') {

            steps {

                script {

                    /*
                    ----------------------------------------------------------
                    Read GitHub Webhook
                    ----------------------------------------------------------
                    */

                    def payload = readJSON(
                        text: env.POST_CONTENT
                    )

                    if (!payload.pull_request) {

                        currentBuild.result = "NOT_BUILT"

                        env.PROCESS_REQUEST = "false"

                        echo "Ignoring non Pull Request event."

                        return
                    }

                    /*
                    ----------------------------------------------------------
                    Only process merged Pull Requests
                    ----------------------------------------------------------
                    */

                    if (payload.action != "closed") {

                        env.PROCESS_REQUEST = "false" 
                        currentBuild.result = "NOT_BUILT"

                        echo "Ignoring event: ${payload.action}"

                        return
                    }

                    if (!payload.pull_request.merged) {

                        env.PROCESS_REQUEST = "false"

                        currentBuild.result = "NOT_BUILT"

                        echo "PR closed without merge."

                        return
                    }

                    /*
                    ----------------------------------------------------------
                    Read Deployment Labels
                    ----------------------------------------------------------
                    */

                    def CONFIG = loadMappings()

                    def labels =
                        payload.pull_request.labels.collect {

                            it.name
                        }

                    def targetEnv = null

                    def actions = []

                    labels.each { label ->

                        if (CONFIG.labels.env.containsKey(label)) {

                            targetEnv =
                                CONFIG.labels.env[label]
                        }

                        if (CONFIG.labels.actions.containsKey(label)) {

                            actions =
                                CONFIG.labels.actions[label]
                        }
                    }

                    /*
                    ----------------------------------------------------------
                    Ignore PRs without deployment labels
                    ----------------------------------------------------------
                    */

                    if (!targetEnv || actions.isEmpty()) {

                        env.PROCESS_REQUEST = "false"

                        currentBuild.result = "NOT_BUILT"

                        echo """
                        No deployment labels found.

                        Labels:

                        ${labels.join(", ")}
                        """

                        return
                    }

                    /*
                    ----------------------------------------------------------
                    Create Deployment Request
                    ----------------------------------------------------------
                    */

                    def request = [

                        id : UUID.randomUUID().toString(),

                        app :
                            payload.repository.name,

                        pr :
                            payload.pull_request.number,

                        env :
                            targetEnv,

                        actions :
                            actions,

                        status :
                            "pending",

                        requested_by :
                            payload.pull_request.merged_by.login,

                        requested_at :
                            new Date().format(
                                "yyyy-MM-dd'T'HH:mm:ss'Z'",
                                TimeZone.getTimeZone("UTC")
                            )
                    ]

                    updateRequests(

                        action : "add",

                        request : request
                    )

                    env.PROCESS_REQUEST = "true"

                    /*
                    ----------------------------------------------------------
                    Summary
                    ----------------------------------------------------------
                    */

                    echo """

                    =====================================

                    DEPLOYMENT REQUEST CREATED

                    =====================================

                    APP        : ${request.app}

                    PR         : #${request.pr}

                    ENV        : ${request.env}

                    ACTIONS    : ${request.actions.join(',')}

                    REQUESTED  : ${request.requested_by}

                    STATUS     : ${request.status}

                    """
                }
            }
        }

        stage('Trigger Orchestrator') {

            when {

                expression {

                    return env.PROCESS_REQUEST == "true"
                }
            }

            steps {

                build(

                    job: 'Orchestrator-Pipeline',

                    wait: false
                )
            }
        }
    }
}