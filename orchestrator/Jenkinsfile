@Library('cicd-library') _

/*
|--------------------------------------------------------------------------
| Orchestrator Pipeline
|--------------------------------------------------------------------------
|
| Responsibilities
| ----------------
| 1. Load application mapping from current.yaml
| 2. Detect repository changes across applications
| 3. Start builder VM dynamically when builds are required
| 4. Queue and trigger Build-Pipeline jobs
| 5. Trigger Promotion-Pipeline after successful builds
| 6. Stop builder VM after pipeline completion
|
| This pipeline DOES NOT:
| - build WARs
| - build Docker images
| - deploy applications
|
| Those responsibilities are delegated to:
| - Build-Pipeline
| - Promotion-Pipeline
| - Deploy-Pipeline
|
|--------------------------------------------------------------------------
*/

import org.jenkinsci.plugins.gwt.GenericTrigger

def CONFIG = null
def BUILD_QUEUE = []

pipeline {

    agent any

    triggers {

        GenericTrigger(
            token: 'orchestrator-trigger'
        )

        cron('H/30 8-9,13-14,18-19 * * *')
    }

    options {

        disableConcurrentBuilds(
            abortPrevious: false
        )

        buildDiscarder(
            logRotator(numToKeepStr: '5')
        )

        timestamps()
    }

    environment {

        CONTROL_REPO =
        "git@github.com:profit-apps-inc/jenkins-cicd-env-control.git"

        CONTROL_BRANCH =
        "cicd"

        STATE_DIR =
        "/u01/jenkins/jenkins/build-state"

        BUILD_AGENT =
        "jenkins-builder-01"

        BUILD_ZONE =
        "us-east1-b"
    }

    stages {

        stage('Load Mapping') {
            /*
            Load centralized environment/application mapping.

            current.yaml acts as the source of truth for:
            - repositories
            - branches
            - environments
            - registry configuration
            - workloads
            */

            steps {

                script {

                    echo """
                    =====================================
                    Loading Mapping
                    =====================================

                    Repo   : ${env.CONTROL_REPO}
                    Branch : ${env.CONTROL_BRANCH}
                    """

                    dir('env-control') {

                        deleteDir()

                        git(
                            url: env.CONTROL_REPO,
                            branch: env.CONTROL_BRANCH,
                            credentialsId: 'git-opsuser-ro-repo'
                        )
                    }

                    CONFIG = readYaml(
                        file: 'env-control/mappings/current.yaml'
                    )

                    if (!CONFIG?.mappings) {

                        error """
                        ❌ mappings missing in current.yaml
                        """
                    }

                    echo """
                    =====================================
                    ✅ Mapping Loaded
                    =====================================
                    """
                }
            }
        }

        stage('Detect Changes') {

            /*
            Detect latest commits from all configured repositories.

            Only applications with new commits compared to the
            controller state directory are added to BUILD_QUEUE.

            This avoids unnecessary WAR/Docker rebuilds.
            */
            steps {

                script {

                    BUILD_QUEUE = []

                    def seen = []

                    def parsed = CONFIG.mappings                    
                    
                    parsed.each { key, value ->

                        def app = value.app.toString()                        
                        def repo = value.repo.toString()
                        def branch = value.branch.toString()
                        def envName = value.env.toString()
                        def actions =

                        (value.actions ?: [])
                        .collect { it.toString().trim() }
                        
                        def id =
                        "${repo}:${branch}"

                        if (seen.contains(id)) {

                            error """
                            ❌ Duplicate Mapping

                            ${id}
                            """
                        }

                        seen << id

                        echo """
                        =====================================
                        Checking Repository
                        =====================================

                        APP        : ${app}
                        REPO       : ${repo}
                        BRANCH     : ${branch}
                        ENV        : ${envName}
                        ACTIONS    : ${actions.join(',')}
                        """

                        def commit = sh(

                        script: """
                        git ls-remote ${repo} refs/heads/${branch} \
                        | cut -f1
                        """,

                        returnStdout: true

                    ).trim()

                    if (!commit) {

                        echo """
                        ⚠️ Unable to fetch commit

                        APP : ${app}
                        """

                        return
                    }

                        def commitFile =
                        "${env.STATE_DIR}/${app}/${envName}.commit"

                        def lastBuilt = sh(

                            script: """
                            [ -f ${commitFile} ] &&
                            cat ${commitFile} ||
                            echo none
                            """,

                            returnStdout: true

                        ).trim()

                        echo """
                        =====================================
                        LATEST COMMIT : ${commit}
                        LAST BUILT    : ${lastBuilt}
                        =====================================
                        """

                        if (commit == lastBuilt) {

                            echo """
                            No changes detected

                            APP : ${app}
                            """

                            return
                        }
                       
                        /*
                        Applications with detected changes are queued
                        for downstream Build-Pipeline execution.
                        */
                        BUILD_QUEUE << [

                            app           : app,
                            branch        : branch,            
                            env           : envName,                            
                            commit        : commit,
                            actions       : actions
                        ]

                        echo """
                        Build queued

                        APP : ${app}
                        """
                    }

                    if (BUILD_QUEUE.isEmpty()) {

                        env.HAS_CHANGES = "false"

                        currentBuild.description =
                        "No changes"
                      
                        echo """
                        =====================================
                        No Changes Across Repositories
                        =====================================
                        """

                        return
                    }

                    env.HAS_CHANGES = "true"

                    echo """
                    =====================================
                    Build Queue
                    =====================================

                    ${BUILD_QUEUE.collect {
                        """
                        APP    : ${it.app}
                        BRANCH : ${it.branch}
                        ENV    : ${it.env}
                        ACTIONS : ${it.actions.join(',')}
                        """
                    }.join('\n')}
                    """
                }
            }
        }

        stage('Start Build VM') {
            /*
            Builds are executed on a dedicated builder VM instead
            of the Jenkins controller.

            Advantages:
            - controller isolation
            - Docker daemon isolation
            - scalable executor model
            - reduced controller resource usage
            */

            when {

                expression {
                    env.HAS_CHANGES == "true"
                }
            }

            steps {

                script {

                    echo """
                    =====================================
                    Starting Builder VM
                    =====================================

                    VM   : ${env.BUILD_AGENT}
                    ZONE : ${env.BUILD_ZONE}
                    """

                    sh """
                    gcloud compute instances start \
                    ${env.BUILD_AGENT} \
                    --zone=${env.BUILD_ZONE}
                    """

                    echo """
                    Waiting for builder registration...
                    """

                    sleep(
                        time: 90,
                        unit: 'SECONDS'
                    )

                    echo """
                    ✅ Builder Ready
                    """
                }
            }
        }

        stage('Run Build Pipelines') {

            when {

                expression {
                    env.HAS_CHANGES == "true"
                }
            }

            steps {

                script {

                    BUILD_QUEUE.each { item ->

                        echo """
                        =====================================
                        Triggering Build Pipeline
                        =====================================

                        APP     : ${item.app}
                        ENV     : ${item.env}
                        BRANCH  : ${item.branch}
                        COMMIT  : ${item.commit}
                        ACTIONS : ${item.actions.join(',')}
                        """

                        notify(
                            app: item.app,
                            env: item.env,
                            msg:
                            "BUILD REQUEST (${item.branch})",
                            commit: item.commit
                        )

                        echo """
                        =====================================
                        FINAL ACTION PARAM
                        =====================================

                        ${item.actions}
                        ${item.actions.join(',')}

                        =====================================
                        """

                        def actionsParam = ""

                        if (item.actions) {

                            actionsParam = item.actions.collect {

                                it.toString().trim()

                            }.join(',')
                        }

                        def buildResult = build(

                            job: 'Build-Pipeline',

                            wait: true,

                            propagate: true,

                            parameters: [

                                string(name: 'APP_NAME', value: item.app),
                                string(name: 'TARGET_ENV', value: item.env),
                                string(name: 'COMMIT_FULL', value: item.commit)
                            ]
                        )

                        String buildVersion = ""
                        String buildCommit  = ""

                        buildVersion =
                        buildResult.getDescription()

                        buildCommit =
                        item.commit

                        echo """
                        =====================================
                        ✅ Build Completed
                        =====================================

                        APP     : ${item.app}
                        VERSION : ${buildVersion}
                        """

                        if (

                            item.actions.contains('build') &&

                            item.actions.contains('deploy')
                        ) {

                            build(

                                job: 'Promotion-Pipeline',

                                wait: true,

                                propagate: true,

                                parameters: [

                                    string(name: 'APP_NAME', value: item.app),
                                    string(name: 'TARGET_ENV', value: item.env),
                                    string(name: 'VERSION', value: buildVersion),
                                    string(name: 'COMMIT_FULL', value: buildCommit)
                                ]
                            )                        
                        }                            
                    }
                }
            }
        }
    }

    post {

        always {

            script {

                if (env.HAS_CHANGES == "true") {

                    echo """
                    =====================================
                    STOPPING Builder VM
                    =====================================

                    VM   : ${env.BUILD_AGENT}
                    ZONE : ${env.BUILD_ZONE}
                    """

                    sh """
                    gcloud compute instances stop \
                    ${env.BUILD_AGENT} \
                    --zone=${env.BUILD_ZONE}
                    """

                    echo """
                    ✅ Builder VM Stopped
                    """
                }
            }
        }

        failure {

            script {

                notify(
                    app: "orchestrator",
                    env: "orchestrator",
                    msg: "FAILED ❌"
                )
            }
        }

        success {

            echo """
            =====================================
            ✅ ORCHESTRATOR SUCCESS
            =====================================
            """
        }
    }
}