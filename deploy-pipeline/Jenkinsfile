@Library('cicd-library') _

def WEBHOOKS = []

def CONFIG = null
def MAPPING = null
def DEPLOY = null

pipeline {

    agent any

    parameters {
        string(name: 'APP_NAME')
        string(name: 'TARGET_ENV')
        string(name: 'COMMIT_FULL')
        string(name: 'VERSION')
        text(name:'NOTIFICATION_WEBHOOKS', defaultValue:'[]')
    }

    options {
        disableConcurrentBuilds(abortPrevious: true)
        buildDiscarder(logRotator(numToKeepStr: '10'))
        timestamps()
    }

    environment {

        DEPLOY_HISTORY_DIR =
        "/u01/jenkins/jenkins/deploy-history"

        DEPLOY_DIR =
        "/u01/jenkins/jenkins/deploy-state"
    }

    stages {

        stage('Init') {

            steps {

                deleteDir()

                echo """
                =====================================
                Workspace Cleaned
                =====================================
                """
            }
        }

        stage('Load Mapping') {

            steps {

                script {

                    WEBHOOKS = readJSON(
                        text: params.NOTIFICATION_WEBHOOKS
                    )

                    echo "WEBHOOKS LOADED: ${WEBHOOKS}"

                     echo """
                    =====================================
                    Loading Deployment Mapping
                    =====================================

                    APP : ${params.APP_NAME}
                    ENV : ${params.TARGET_ENV}
                    """                    
                    
                    CONFIG = loadConfig(
                        params.APP_NAME,
                        params.TARGET_ENV
                    )

                    MAPPING = CONFIG.mapping

                    DEPLOY =
                        MAPPING.deploy ?: [:]

                    def SHARED =
                        CONFIG.environment.shared ?: [:]

                    env.DEPLOY_TYPE =
                        (DEPLOY.type ?: "").toString()

                    env.SSH_HOST =
                        (SHARED.ssh_host ?: "").toString()

                    env.NAMESPACE =
                        (SHARED.namespace ?: "").toString()

                    env.IMAGE =
                        "${MAPPING.registry}/${MAPPING.image_repo}:${params.VERSION}"

                    echo """
                    =====================================
                    DEPLOY DEBUG
                    =====================================

                    SSH_HOST  : ${env.SSH_HOST}
                    NAMESPACE : ${env.NAMESPACE}
                    IMAGE     : ${env.IMAGE}
                    """    

                    echo """
                    =====================================
                    Deployment Mapping
                    =====================================

                    IMAGE   : ${env.IMAGE}
                    TYPE     : ${DEPLOY.type}
                    STRATEGY : ${DEPLOY.strategy}
                    TARGETS : ${(DEPLOY.targets ?: [:]).keySet()}
                    """

                    echo """
                    =====================================
                    RAW CONFIG
                    =====================================

                    ${groovy.json.JsonOutput.prettyPrint(
                        groovy.json.JsonOutput.toJson(CONFIG)
                    )}
                    """
                }
            }
        }       
        

        stage('Deploy') {

            steps {

                script {

                    def deployJobs = [:]

                    if (!(DEPLOY.targets instanceof Map) || DEPLOY.targets.isEmpty()) {

                        error """
                        ❌ No deployment targets defined

                        APP : ${params.APP_NAME}
                        ENV : ${params.TARGET_ENV}
                        """
                    }

                    DEPLOY.targets.each { name, target ->

                        deployJobs[name] = {

                            notify(                               
                                app: params.APP_NAME,
                                env: params.TARGET_ENV,
                                msg: "DEPLOYMENT STARTED",
                                webhooks: WEBHOOKS
                            )

                            deploy(
                                deployType : env.DEPLOY_TYPE,
                                sshHost    : env.SSH_HOST,
                                context    : target.context,
                                namespace  : env.NAMESPACE,
                                statefulset: target.sts,
                                image      : env.IMAGE
                            )

                            notify(                               
                                app: params.APP_NAME,
                                env: params.TARGET_ENV,
                                msg: "DEPLOYMENT ENDED",
                                webhooks: WEBHOOKS
                            )                            
                        }
                    }

                    parallel deployJobs

                    parallel deployJobs

                    echo """
                    =====================================
                    PARALLEL DEPLOY COMPLETE
                    =====================================
                    """
                }
            }
        }        

        stage('Deployment History') {

            steps {

                script {

                    echo """
                    =====================================
                    Recording Deployment History
                    =====================================
                    """

                    def history = [
                        app     : params.APP_NAME,
                        env     : params.TARGET_ENV,
                        commit  : params.COMMIT_FULL,
                        version : params.VERSION,
                        image   : env.IMAGE,
                        build   : env.BUILD_NUMBER,
                        targets : DEPLOY.targets.keySet(),
                        type    : "DEPLOY"
                    ]

                    deployHistory(history)

                    notifyHistory(history)

                    echo """
                    ✅ Deployment History Recorded
                    """
                }
            }
        }
    

        stage('Update Deployment State') {

            steps {
                sh """
                mkdir -p \
                ${env.DEPLOY_DIR}/${params.APP_NAME}

                echo ${params.COMMIT_FULL} > \
                ${env.DEPLOY_DIR}/${params.APP_NAME}/${params.TARGET_ENV}.commit
                """

                echo """
                =====================================
                ✅ Deployment State Updated
                =====================================
                """
            }
        }        
    }
    post {

        success {

            script {

                echo """
                =====================================
                ✅ DEPLOY SUCCESS
                =====================================

                APP      : ${params.APP_NAME}
                VERSION  : ${params.VERSION}
                IMAGE    : ${env.IMAGE}
                ENV      : ${params.TARGET_ENV}
                """

                notify(
                    app: params.APP_NAME,
                    env: params.TARGET_ENV,
                    msg: "DEPLOY SUCCESS",
                    version: params.VERSION,
                    commit: params.COMMIT_FULL,
                    image: env.IMAGE,
                    webhooks: WEBHOOKS
                )
            }
        }

        failure {

            script {

                echo """
                =====================================
                ❌ DEPLOY FAILED
                =====================================

                APP      : ${params.APP_NAME}
                VERSION  : ${params.VERSION}
                IMAGE    : ${env.IMAGE}
                ENV      : ${params.TARGET_ENV}
                """

                notify(
                    app: params.APP_NAME,
                    env: params.TARGET_ENV,
                    msg: "DEPLOY FAILED ❌",
                    version: params.VERSION,
                    commit: params.COMMIT_FULL,
                    image: env.IMAGE,
                    webhooks: WEBHOOKS
                )
            }
        }

        always {

            script {

                echo """
                =====================================
                DEPLOY PIPELINE COMPLETE
                =====================================
                """
            }
        }
    }
}
