@Library('cicd-library') _

def WEBHOOKS = []

pipeline {

    agent { label 'docker-builder' }

    parameters {

        string(name: 'APP_NAME')
        string(name: 'TARGET_ENV')
        string(name: 'COMMIT_FULL')
        string(name: 'REPO_URL')
        string(name: 'BRANCH_NAME')
        string(name: 'REGISTRY')
        string(name: 'IMAGE_REPO')
        string(name: 'DOCKER_REPO')
        string(name: 'DOCKER_BRANCH')
        string(name: 'DOCKER_DIR')
        text(name:'NOTIFICATION_WEBHOOKS', defaultValue:'[]')
    }

    options {
        disableConcurrentBuilds(abortPrevious: true)
        buildDiscarder(logRotator(numToKeepStr: '10'))
        timestamps()
    }
    
    environment {

        IMAGE =
        "${params.REGISTRY}/${params.IMAGE_REPO}"

        ARTIFACT_DIR =
        "/u01/jenkins/jenkins/artifacts/${params.APP_NAME}"
        
    }

    // ─────────────────────────────────────────────────────────────────────
    stages {
        
        // ── 1. Checkout App Repo ──────────────────────────────────────────
        stage('Checkout App Repo') {

            steps {

                echo """
                =====================================
                Checkout App Repository
                =====================================

                REPO   : ${params.REPO_URL}
                BRANCH : ${params.BRANCH_NAME}
                """

                script {

                    WEBHOOKS = readJSON(
                        text: params.NOTIFICATION_WEBHOOKS
                    )

                    echo "WEBHOOKS LOADED: ${WEBHOOKS}"

                    if (!fileExists('.git')) {

                        echo """
                        =====================================
                        Initial Clone
                        =====================================
                        """

                        checkout([
                            $class: 'GitSCM',

                            branches: [[
                                name: "*/${params.BRANCH_NAME}"
                            ]],

                            userRemoteConfigs: [[
                                url: params.REPO_URL,
                                credentialsId: 'github-token'
                            ]],

                            extensions: [[
                                $class: 'CloneOption',
                                shallow: true,
                                depth: 1,
                                noTags: true,
                                honorRefspec: true
                            ]]
                        ])

                    } else {

                        echo """
                        =====================================
                        Reusing Existing Repository
                        =====================================
                        """

                        sh """
                        git remote set-url origin ${params.REPO_URL}

                        git fetch \
                        --depth=1 \
                        --no-tags \
                        origin \
                        ${params.BRANCH_NAME}

                        git checkout -B \
                        ${params.BRANCH_NAME} \
                        origin/${params.BRANCH_NAME}

                        git reset --hard \
                        origin/${params.BRANCH_NAME}

                        git clean -fdx
                        """
                    }
                }
                
                notify(
                    app: params.APP_NAME,
                    env: params.TARGET_ENV,
                    msg: "BUILD STARTED",
                    commit: params.COMMIT_FULL,
                    webhooks: WEBHOOKS
                )
            }
        }        

        // ── 2. Checkout Docker Repo ───────────────────────────────────────
        stage('Checkout Docker Repo') {            
            steps {
                echo """
                =====================================
                Checkout Docker Repository
                =====================================
                REPO    : ${params.DOCKER_REPO}
                BRANCH  : ${params.DOCKER_BRANCH}
                CONTEXT : ${params.DOCKER_DIR}
                """
                dir("${params.DOCKER_DIR}") {
                    deleteDir()
                    git(
                        url:           params.DOCKER_REPO,
                        branch:        params.DOCKER_BRANCH,
                        credentialsId: 'github-token'
                    )
                }
            }
        }

        // ── 3. Versioning ───────────────────────────────────────
        stage('Versioning') {

            steps {

                script {

                    env.COMMIT_SHORT =
                    params.COMMIT_FULL.take(7)

                    env.VERSION =
                    generateVersion(
                        env.IMAGE,
                        env.COMMIT_SHORT
                    )

                    env.COMMIT_FULL =
                    params.COMMIT_FULL

                    currentBuild.description =
                    env.VERSION

                    currentBuild.displayName =
                    "${params.APP_NAME} ${env.VERSION}"

                    echo """
                    =====================================
                    Build Metadata
                    =====================================

                    VERSION : ${env.VERSION}
                    COMMIT  : ${params.COMMIT_FULL}
                    IMAGE   : ${env.IMAGE}
                    """
                }
            }
        }

        // ── 4. Build WAR ──────────────────────────────────────────────────
        stage('Build WAR') {

            steps {

                script {

                    notify(

                        app: params.APP_NAME,
                        env: params.TARGET_ENV,
                        msg: "WAR GENERATION STARTED",
                        webhooks: WEBHOOKS
                    )

                    WAR_MD5 = buildWar(

                        app      : params.APP_NAME,
                        env      : params.TARGET_ENV,
                        commit   : params.COMMIT_FULL,
                        cacheDir : env.ARTIFACT_DIR
                    )

                    notify(

                        app: params.APP_NAME,
                        env: params.TARGET_ENV,
                        msg: "WAR READY",
                        webhooks: WEBHOOKS
                    )
                }
            }
        }  

        // ── 5. Docker Build + Push ───────────────────────────────────────
        stage('Docker Build + Push') {

            steps {

                script {

                    notify(

                        app: params.APP_NAME,
                        env: params.TARGET_ENV,
                        msg: "DOCKER BUILD STARTED",
                        webhooks: WEBHOOKS
                    )

                    dockerBuild(

                        image     : env.IMAGE,
                        tag       : env.VERSION,
                        dockerDir : params.DOCKER_DIR,
                        warFile   : "build-output/app.war"
                    )

                    notify(

                        app: params.APP_NAME,
                        env: params.TARGET_ENV,
                        msg: "IMAGE READY",
                        webhooks: WEBHOOKS
                    )
                }
            }
        }        

        // ── 6. Notify Ready ──────────────────────────────────────────────
        stage('Notify Ready') {            
            steps {
                notify(
                    app:     params.APP_NAME,
                    env:     params.TARGET_ENV,
                    msg:     "BUILD ARTIFACT READY",
                    version: env.VERSION,
                    commit:  params.COMMIT_FULL,
                    md5:     WAR_MD5,
                    image:   "${env.IMAGE}:${env.VERSION}",
                    webhooks: WEBHOOKS
                )
            }
        }

        // ── 7. Publish Build Metadata ────────────────────────────────────
        stage('Publish Build Metadata') {            

            steps {

                script {                    
                    

                    currentBuild.description =
                    groovy.json.JsonOutput.toJson([

                        version : env.VERSION,
                        image   : "${env.IMAGE}:${env.VERSION}"
                    ])

                    echo """
                    =====================================
                    BUILD METADATA
                    =====================================

                    VERSION : ${env.VERSION}
                    IMAGE   : ${env.IMAGE}:${env.VERSION}
                    """
                }
            }
        }

    } // end stages

    // ── Post ──────────────────────────────────────────────────────────────
    post {

        success {
            echo """
            =====================================
            ✅ BUILD SUCCESS
            =====================================
            """
        }

        failure {
            script {
                notify(
                    app:     params.APP_NAME,
                    env:     params.TARGET_ENV,
                    msg:     "BUILD FAILED ❌",
                    version: env.VERSION,
                    commit:  params.COMMIT_FULL,
                    image:   "${env.IMAGE}:${env.VERSION}",
                    webhooks: WEBHOOKS
                )
            }
        }

        always {
            cleanWs()
        }
    }
}