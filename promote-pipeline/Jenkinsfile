@Library('cicd-library') _

pipeline {

    agent any

    parameters {

        string(name: 'APP_NAME')
        string(name: 'TARGET_ENV')
        string(name: 'VERSION')
        string(name: 'COMMIT_FULL')
    }

    options {

        disableConcurrentBuilds(
            abortPrevious: true
        )

        buildDiscarder(
            logRotator(numToKeepStr: '10')
        )

        timestamps()
    }

    environment {

        STATE_DIR =
        "/u01/jenkins/jenkins/build-state"
    }

    stages {

        stage('Validate Input') {

            steps {

                script {

                    def config =
                    loadConfig(
                        params.APP_NAME,
                        params.TARGET_ENV
                    )

                    def mapping =
                    config.mapping

                    env.IMAGE =
                    "${mapping.registry}/${mapping.image_repo}:${params.VERSION}"

                    if (
                        !params.APP_NAME ||
                        !params.VERSION ||
                        !params.COMMIT_FULL ||
                        !params.TARGET_ENV
                    ) {

                        error """
                        ❌ Missing Required Parameters
                        """
                    }

                    echo """
                    =====================================
                    🚀 Promotion Request
                    =====================================

                    APP       : ${params.APP_NAME}
                    ENV       : ${params.TARGET_ENV}
                    VERSION   : ${params.VERSION}
                    COMMIT    : ${params.COMMIT_FULL}
                    IMAGE     : ${env.IMAGE}
                    """
                }
            }
        }

        stage('Approval Gate') {

            when {

                expression {
                    params.TARGET_ENV == 'prod'
                }
            }

            steps {

                timeout(
                    time: 30,
                    unit: 'MINUTES'
                ) {

                    input(

                        message: """
                        Approve PROD Deployment?

                        APP     : ${params.APP_NAME}
                        VERSION : ${params.VERSION}
                        COMMIT  : ${params.COMMIT_FULL}
                        """,

                        ok: "Approve PROD Deploy"
                    )
                }
            }
        }

        stage('Validate Promotion Flow') {

            when {

                expression {
                    params.TARGET_ENV == 'prod'
                }
            }

            steps {

                script {

                    def order =
                    ['stag', 'uat', 'prod']

                    def prev =
                    order[
                        order.indexOf(
                            params.TARGET_ENV
                        ) - 1
                    ]

                    def file =
                    "${env.STATE_DIR}/${params.APP_NAME}/${prev}.commit"

                    def last = sh(

                        script: """
                        [ -f ${file} ] &&
                        cat ${file} ||
                        echo none
                        """,

                        returnStdout: true

                    ).trim()

                    echo """
                    =====================================
                    Promotion Validation
                    =====================================

                    REQUIRED ENV : ${prev}
                    REQUIRED SHA : ${params.COMMIT_FULL}
                    DEPLOYED SHA : ${last}
                    """

                    if (last != params.COMMIT_FULL) {

                        error """
                        ❌ Promotion Blocked

                        ${prev.toUpperCase()}
                        does not contain this commit
                        """
                    }

                    echo """
                    ✅ Promotion Validation Passed
                    """
                }
            }
        }

        stage('Trigger Deploy Pipeline') {

            steps {

                script {

                    stageExec(
                        params.APP_NAME,
                        params.TARGET_ENV,
                        "PROMOTION"
                    ) {

                        echo """
                        =====================================
                        Triggering Deploy Pipeline
                        =====================================
                        """

                        build(

                            job: 'Deploy-Pipeline',

                            wait: true,
                            propagate: true,

                            parameters: [

                                string(
                                    name: 'APP_NAME',
                                    value: params.APP_NAME
                                ),

                                string(
                                    name: 'TARGET_ENV',
                                    value: params.TARGET_ENV
                                ),

                                string(
                                    name: 'VERSION',
                                    value: params.VERSION
                                ),

                                string(
                                    name: 'COMMIT_FULL',
                                    value: params.COMMIT_FULL
                                )
                            ]
                        )
                    }
                }
            }
        }

        stage('Update Promotion State') {

            steps {

                sh """
                mkdir -p \
                ${env.STATE_DIR}/${params.APP_NAME}

                echo ${params.COMMIT_FULL} > \
                ${env.STATE_DIR}/${params.APP_NAME}/${params.TARGET_ENV}.commit
                """

                echo """
                =====================================
                ✅ Promotion State Updated
                =====================================
                """
            }
        }
    }

    post {

        success {

            echo """
            =====================================
            ✅ PROMOTION SUCCESS
            =====================================

            APP      : ${params.APP_NAME}
            ENV      : ${params.TARGET_ENV}
            VERSION  : ${params.VERSION}
            """
        }

        failure {

            echo """
            =====================================
            ❌ PROMOTION FAILED
            =====================================

            APP      : ${params.APP_NAME}
            ENV      : ${params.TARGET_ENV}
            VERSION  : ${params.VERSION}
            """
        }
    }
}
